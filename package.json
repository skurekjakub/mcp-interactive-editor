{
  "name": "mcp-interactive-editor",
  "version": "0.6.1",
  "type": "module",
  "description": "An MCP App that opens an interactive editor for every file write a model proposes. You edit it by hand, and nothing reaches disk until you say so.",
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "bump": "node scripts/bump-version.mjs",
    "pack": "npm run build && npm run bundle && mcpb pack bundle dist/mcp-interactive-editor.mcpb",
    "preview": "vite --port 5178",
    "pretest": "npm run build && npm run bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:dead": "knip",
    "lint:comments": "node scripts/check-comments.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run lint:comments && npm run lint:dead && npm test",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "license": "MIT",
  "author": "skurekjakub",
  "keywords": [
    "mcp",
    "mcp-app",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "filesystem",
    "code-review",
    "diff",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skurekjakub/mcp-interactive-editor.git"
  },
  "homepage": "https://github.com/skurekjakub/mcp-interactive-editor#readme",
  "bugs": {
    "url": "https://github.com/skurekjakub/mcp-interactive-editor/issues"
  },
  "private": true
}

  "license": "MIT",
  "keywords": ["mcp", "filesystem", "review", "diff", "human-in-the-loop"],
  "mcpServers": {
    "interactive-editor": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bundle/server/index.js", "--root-from-cwd"]
    }
  }
}
